<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	  <PublishSingleFile>true</PublishSingleFile>
	  <SelfContained>true</SelfContained>
	  <RuntimeIdentifier>win-x64</RuntimeIdentifier>
	  <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>


	<ItemGroup>
		<Content Include="index.html" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
		<Content Include="encryption.js" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
		<Content Include="cloudflared.exe" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
	</ItemGroup>

	<!-- Force MSBuild to copy cloudflared.exe from the source folder into the publish folder -->
	<Target Name="CopyCloudflaredToPublish" AfterTargets="Publish">
		<Copy SourceFiles="cloudflared.exe" DestinationFolder="$(PublishDir)" ContinueOnError="false" />
	</Target>
</Project>
